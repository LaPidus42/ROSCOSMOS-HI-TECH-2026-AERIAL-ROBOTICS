[Unit]
Description=Thermal camera (ROS topic via rosbridge) H.264 RTP stream
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/default/thermal-stream
ExecStart=/usr/bin/python3 -u /usr/local/bin/thermal-stream
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
